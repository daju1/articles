  |         + F_I_rotB_conj_l
  |         + F_dyn_I_D_l
  |         + t_Dn_conj_l
  |         + p_Et_conj_l
  |         + F_P_rotE_conj_l
  |         + F_dyn_P_B_l
  |         + f_jump_maxwell_left
  |         + p_Bt_je_ext_B_conj_left
  |     ).n(prec=128)
  | 
  |     force_dyn_right = (
  |         + F_jmD_conj_right
  |         + p_Bt_jeB_conj_right
  |         + p_I_conv_Ht_conj_right
  |         + t_I_conv_Hn_conj_right
  |         + F_I_rotB_conj_r
  |         + F_dyn_I_D_r
  |         + t_Dn_conj_r
  |         + p_Et_conj_r
  |         + F_P_rotE_conj_r
  |         + F_dyn_P_B_r
  |         + f_jump_maxwell_right
  |         + F_jm_ext_D_conj_right

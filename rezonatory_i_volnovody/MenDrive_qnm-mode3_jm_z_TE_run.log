  |     f_jump_maxwell_left = maxwell_tensor_v['T_xx'].subs(x == -A_val, b == B_val).n(prec=128).real() \
  |                         - maxwell_tensor_l['T_xx'].subs(x == -A_val, b == B_val).n(prec=128).real()
  | 
  |     # Скачок тензора Максвелла на границе вакуума и правого проводника

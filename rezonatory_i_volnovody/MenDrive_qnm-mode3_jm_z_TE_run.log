  |     # $$ T_n = \frac{{{D'}_n}^2}{2 \epsilon'} - \frac{{{D''}_n}^2}{2 \epsilon''} $$
  |     t_Dn_conj_l = calc_t_Dn_left_conductor_conj (Ex_l_d, dv, omega_sol_cur)
